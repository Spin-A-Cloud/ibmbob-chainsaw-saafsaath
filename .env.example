# ── WhatsApp Business Cloud API ──────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here
WHATSAPP_API_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# ── Instagram Graph API ───────────────────────────────────────────────────────
# Access token with instagram_basic, instagram_content_publish scopes
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
# Your Instagram Business / Creator account ID
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

# ── Reverse Geocoding (Nominatim — free, no key required) ────────────────────
# Optional: override the Nominatim user-agent string
NOMINATIM_USER_AGENT=CleanBengaluru/1.0

# ── Hashtags appended to every Instagram caption ─────────────────────────────
INSTAGRAM_HASHTAGS=#CleanBengaluru #SwachhBharat #WasteManagement #Bengaluru

# ── Public base URL of this server ───────────────────────────────────────────
# Must be reachable by Instagram's servers. Use ngrok for local dev.
# e.g.  BASE_URL=https://abc123.ngrok.io
BASE_URL=https://your-domain.com
